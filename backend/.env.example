# ─────────────────────────────────────────────────────────────────────────────
# LLM Gateway — environment variable reference
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq API keys ─────────────────────────────────────────────────────────────
#
# Option A (recommended): comma-separated list of keys, one line.
# The gateway will round-robin across them.  Each key gets its own cooldown
# so a 429 on key 1 does not block key 2.
#
# Rules for the value:
#   - Comma-separated, all on ONE line (no line continuation).
#   - Spaces around commas are fine — the code strips them.
#   - A trailing comma is harmless — empty entries are ignored.
#   - Do NOT use quotes around the value.
#
GROQ_API_KEYS=gsk_placeholder_key_1,gsk_placeholder_key_2,gsk_placeholder_key_3

#
# Option B (legacy / single key): kept for backward compatibility.
# If GROQ_API_KEYS is set and non-empty, GROQ_API_KEY is ignored.
# Leave this blank if you set GROQ_API_KEYS above.
#
# GROQ_API_KEY=gsk_placeholder_single_key


# ── Gemini API keys ───────────────────────────────────────────────────────────
#
# Same rules as above.
#
GEMINI_API_KEYS=AIzaSy_placeholder_key_1,AIzaSy_placeholder_key_2

#
# Legacy single-key fallback (ignored when GEMINI_API_KEYS is set):
# GEMINI_API_KEY=AIzaSy_placeholder_single_key


# ── Other required keys ───────────────────────────────────────────────────────

JINA_API_KEY=jina_placeholder_key

# Neon (or any Postgres) connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require


# ── Optional overrides (defaults live in app/core/config.py) ─────────────────

# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.8-flash

# GROQ_RPM=30
# GROQ_TPM=8000
# GEMINI_RPM=15
# GEMINI_TPM=32000

# CACHE_SIMILARITY_THRESHOLD=0.90
# CACHE_MAX_SIZE=100
# PROVIDER_TIMEOUT_SECONDS=60.0
